# Copy this file to .env.local and fill in your own Supabase project values.
# Find these under Supabase Dashboard > Project Settings > API.
# NEVER commit .env.local or real credentials to version control.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Set this to your deployed URL (e.g. https://zidaan-2-the-rescue.vercel.app)
# after deploying, so WhatsApp/iMessage link previews resolve the OG image correctly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
